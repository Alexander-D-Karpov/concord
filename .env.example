# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GRPC_PORT=9000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=concord
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=5m
DB_MAX_CONN_IDLE_TIME=5m

# Authentication
JWT_SECRET=change-me-in-production-use-long-random-string-here
JWT_EXPIRATION=15m
REFRESH_EXPIRATION=720h

# Brute-force login lockout (per identifier). Set LOGIN_MAX_ATTEMPTS<=0 to disable.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_PERIOD=15m
LOGIN_ATTEMPT_WINDOW=15m

VOICE_JWT_SECRET=change-me-voice-secret-use-different-long-random-string
VOICE_JWT_EXPIRATION=5m

# OAuth Providers (Optional - leave a provider's CLIENT_ID empty to disable it).
# A provider is advertised by GET /v1/auth/methods only when its CLIENT_ID and
# CLIENT_SECRET are set AND (for OIDC providers like Google) its discovery document
# is reachable at startup. OAuth login also requires Redis (it stores per-request
# PKCE state). Requires Redis; see REDIS_ENABLED.
#
# _REDIRECT_URL is a comma-separated exact-match allowlist of permitted redirect
# URIs (web callback URLs, mobile custom schemes). Loopback redirects
# (http://127.0.0.1:<any-port>/... and http://localhost:<any-port>/...) are ALWAYS
# permitted in addition, so native/desktop apps need no entry here.
#
# To add another provider: append it to oauth.Registry (internal/auth/oauth) and
# set OAUTH_<NAME>_CLIENT_ID / _CLIENT_SECRET / _REDIRECT_URL.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://app.example.com/oauth/callback

# Voice Server Configuration
VOICE_UDP_HOST=0.0.0.0
VOICE_UDP_PORT_START=50000
VOICE_UDP_PORT_END=52000
VOICE_CONTROL_PORT=9001
VOICE_SERVER_ID=
VOICE_REGION=ru-west-1
VOICE_SERVER_NAME=voice-server-1
VOICE_SECRET=change-me-voice-server-secret
VOICE_PUBLIC_HOST=
REGISTRY_URL=localhost:9000
VOICE_HEARTBEAT_INTERVAL=30s
VOICE_CAPACITY=1000

# --- UDP transport ---
# Legacy multi-port pool: VOICE_UDP_PORT_COUNT sockets from VOICE_UDP_PORT_START.
VOICE_UDP_PORT_COUNT=50
VOICE_STATUS_PORT=9092

# Single-port mode (Linux SO_REUSEPORT): one public UDP port + an internal socket
# pool. When true, all rooms use VOICE_PUBLIC_UDP_PORT and the API collapses the
# room->port hash to it. MUST be set the same for concord-api and concord-voice
# (they read this same .env). Simplifies firewalls / the published port range.
VOICE_SINGLE_PORT=true
VOICE_PUBLIC_UDP_PORT=50000
VOICE_SOCKET_COUNT=0             # 0 = NumCPU

# TCP/TLS fallback for clients whose UDP is blocked (0 disables). Media stays
# encrypted with the room key even over plaintext TCP; set the cert/key for TLS.
VOICE_TCP_PORT=8443
VOICE_TLS_CERT=
VOICE_TLS_KEY=

# Voice debug: when true, (1) the API's voice-join RPCs SKIP the room-membership
# check so the throughput/stress harness (tools/voicetest -fast-join) can join
# directly without invites, and (2) the RATE_LIMIT_BYPASS_TOKEN below is honored so
# the harness can register/join many clients fast. DANGER: this lets any
# authenticated user join any room's voice AND bypass rate limits — NEVER enable in
# production. Off by default; both features are dead code when off.
VOICE_DEBUG=false

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_ENABLE_FILE=false
LOG_FILE_PATH=/var/log/concord/app.log

# Metrics & Monitoring
METRICS_ENABLED=true
METRICS_PORT=9100
METRICS_PATH=/metrics

# Voice metrics port
VOICE_METRICS_PORT=9101

# Health Checks
HEALTH_PORT=8081
HEALTH_PATH=/health

# Voice health port
VOICE_HEALTH_PORT=8082

# Storage Configuration
STORAGE_PATH=./uploads
STORAGE_URL=http://localhost:8080/files

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=20
# Clients presenting this token in x-concord-ratelimit-bypass skip rate limits — but
# ONLY when VOICE_DEBUG=true. In production (VOICE_DEBUG off) the token is ignored.
RATE_LIMIT_BYPASS_TOKEN=

# Voice machine-to-machine
VOICE_REGISTER_SECRET=change-me-voice-register-secret

# GIF provider
GIF_API_KEY=

# Push notifications (FCM). Off by default. CredentialsFile = Firebase service-account JSON path.
PUSH_ENABLED=false
PUSH_CREDENTIALS_FILE=